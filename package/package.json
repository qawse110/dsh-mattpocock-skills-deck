{
  "name": "dsh-mattpocock-skills-deck",
  "version": "1.9.0-beta.34",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FeatherHunter/dsh-mattpocock-skills-deck.git"
  },
  "description": "🌹安装即自带mattpocock/skills v1.3.2的27个工程与效率技能，无需手动装技能。520亿token打造本插件，在原始技能之上提供10倍的开发效率，也能帮助新手更快上手该技能套件。支持 GitHub 与 GitLab 的 issue；本地 Markdown 为预览版。感谢您的使用和支持💗",
  "engines": {
    "dsh": ">=0.2.0-rc.2"
  },
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "prepublishOnly": "node ../scripts/build.mts --pkg-only"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./tools": "./deck/registration/agent-row.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "dsh-log": "0.4.1",
    "dsh-plugin-update": "^0.18.39",
    "yaml": "^2.9.1"
  },
  "files": [
    "lib",
    "shared",
    "deck",
    "tracker",
    "refresh",
    "workspace-snapshot",
    "cordis.patch.yml",
    "bundled-skills",
    "bundled-skills-zh",
    "scripts/",
    "CHANGELOG.md",
    "dsh-go"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "plugin",
    "mattpocock",
    "skills",
    "wayfinder",
    "triage",
    "grilling",
    "handoff",
    "issue-tracker",
    "deck"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "dshGo": {
    "v": 1,
    "title": {
      "zh": "技能票台",
      "en": "Tracker Deck"
    },
    "icon": "panel",
    "contributes": {
      "composer.strip": [
        {
          "id": "deck-strip",
          "icon": "panel",
          "text": {
            "zh": "技能票台",
            "en": "Tracker Deck"
          },
          "panel": "map-list"
        }
      ],
      "composer.actions": [
        {
          "id": "deck-open-map",
          "icon": "panel",
          "label": {
            "zh": "看地图",
            "en": "Map"
          },
          "effect": {
            "type": "open",
            "page": "panel:map-list"
          }
        },
        {
          "id": "deck-new-ticket",
          "icon": "add",
          "label": {
            "zh": "新建票",
            "en": "New ticket"
          },
          "effect": {
            "type": "insert",
            "text": "帮我在技能票台里新建一张票（挂到哪张地图下你先问我）："
          }
        }
      ],
      "panels": [
        {
          "id": "map-list",
          "title": {
            "zh": "地图",
            "en": "Maps"
          },
          "icon": "list",
          "placement": [
            "features",
            "chat.panel"
          ],
          "view": "./dsh-go/views/map-list.json"
        },
        {
          "id": "session-work",
          "title": {
            "zh": "本会话的活",
            "en": "This session"
          },
          "icon": "todo",
          "placement": [
            "chat.panel"
          ],
          "view": "./dsh-go/views/session-work.json"
        },
        {
          "id": "ticket-detail",
          "title": {
            "zh": "票详情",
            "en": "Ticket"
          },
          "icon": "document",
          "placement": [
            "session.tab"
          ],
          "presentation": "sheet",
          "view": "./dsh-go/views/ticket-detail.json"
        },
        {
          "id": "settings",
          "title": {
            "zh": "设置",
            "en": "Settings"
          },
          "icon": "settings",
          "placement": [
            "features"
          ],
          "view": "./dsh-go/views/settings.json"
        }
      ]
    }
  },
  "homepage": "https://github.com/FeatherHunter/dsh-mattpocock-skills-deck",
  "license": "MIT"
}
